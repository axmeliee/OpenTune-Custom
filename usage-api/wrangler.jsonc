{
  "name": "opentune-usage",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "ratelimits": [{"name":"LOGIN_LIMITER","namespace_id":"1001","simple":{"limit":5,"period":60}}],
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://justshivv.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "opentune-usage",
    "database_id": "0f977bd8-a4ec-46f9-985f-c1bc8bccac78"
  }]
}

